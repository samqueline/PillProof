{
  "name": "pill-proof-backend",
  "version": "1.0.0",
  "description": "REST API backend for Pill Proof medicine verification and medication tracking application",
  "main": "dist/server.js",
  "scripts": {
    "import": "tsx scripts/import-medicines.ts",
    "migrate": "tsx scripts/migrate-to-mongo.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@valentynb/gs1-parser": "^2.2.1",
